# ==============================================================================
# Real Estate Sales and Management Web Application - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=real_estate_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/real_estate_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API Configuration
PORT=4000
NODE_ENV=production
UPLOAD_DIR=./uploads

# Authentication & JWT Security (Generate strong random secrets for production)
JWT_ACCESS_SECRET=ghana_real_estate_access_jwt_secret_key_2026_secure
JWT_REFRESH_SECRET=ghana_real_estate_refresh_jwt_secret_key_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ghana_real_estate_webhook_token_2026

# Email Integration (Resend API or SMTP)
RESEND_API_KEY=
EMAIL_FROM="Ghana Real Estate" <notifications@realestatedev.gh>
# Optional SMTP Fallback:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://localhost:4000
